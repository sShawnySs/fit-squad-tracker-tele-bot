{
  "name": "telegram-scoreboard-bot",
  "version": "1.0.0",
  "description": "Telegram group activity scoreboard bot on Cloudflare Workers + D1",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:migrate:local": "wrangler d1 migrations apply scoreboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply scoreboard --remote"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.128.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  }
}
