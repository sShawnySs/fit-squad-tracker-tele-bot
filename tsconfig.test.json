{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Tests run in Node (vitest) but exercise code typed against the Workers
    // runtime, so both type sets are in scope here and only here.
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "dev/**/*.ts"]
}
